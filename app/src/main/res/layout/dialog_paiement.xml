<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Récapitulatif financier -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_lilas"
            android:orientation="vertical"
            android:padding="14dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:id="@+id/tvDetailSousTotal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sous-total : 0.0 DT"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvDetailLivraison"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Frais de livraison : 7.0 DT"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/tvDetailTotalFinal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Total TTC : 0.0 DT"
                android:textColor="@color/primary_dark"
                android:textSize="17sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- Adresse de livraison -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Adresse de livraison"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <EditText
            android:id="@+id/etAdresseLivraison"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_card_lilas"
            android:hint="Ex : Avenue Habib Bourguiba, Ariana"
            android:paddingHorizontal="12dp"
            android:text="Ariana, Tunisie"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="14dp" />

        <!-- Choix du mode de paiement -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mode de paiement"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <RadioGroup
            android:id="@+id/rgModePaiement"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp">

            <RadioButton
                android:id="@+id/rbLivraison"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Paiement à la livraison (Espèces)"
                android:textColor="@color/text_primary" />

            <RadioButton
                android:id="@+id/rbCarte"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Carte Bancaire / e-Dinar"
                android:textColor="@color/text_primary" />
        </RadioGroup>

        <!-- Formulaire Carte Bancaire (affiché si sélectionné) -->
        <LinearLayout
            android:id="@+id/layoutCarteBancaire"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <EditText
                android:id="@+id/etTitulaireCarte"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_card_lilas"
                android:hint="Nom du titulaire de la carte"
                android:paddingHorizontal="12dp"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etNumCarte"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_card_lilas"
                android:hint="Numéro de carte (16 chiffres)"
                android:inputType="number"
                android:maxLength="16"
                android:paddingHorizontal="12dp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etDateExp"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_lilas"
                    android:hint="MM/AA"
                    android:maxLength="5"
                    android:paddingHorizontal="12dp"
                    android:layout_marginEnd="8dp" />

                <EditText
                    android:id="@+id/etCvv"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card_lilas"
                    android:hint="CVV"
                    android:inputType="numberPassword"
                    android:maxLength="3"
                    android:paddingHorizontal="12dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>