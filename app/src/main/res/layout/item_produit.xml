<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_lilas"
    android:descendantFocusability="blocksDescendants"
    android:orientation="vertical"
    android:padding="10dp">

    <ImageView
        android:id="@+id/imgProduit"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:background="@color/lilas_pastel"
        android:scaleType="centerCrop"
        android:src="@android:drawable/ic_menu_gallery" />

    <TextView
        android:id="@+id/tvCategorie"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_badge_lilas"
        android:paddingHorizontal="8dp"
        android:paddingVertical="2dp"
        android:text="Catégorie"
        android:textColor="@color/primary_dark"
        android:textSize="11sp"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/tvNomProduit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nom du produit"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginTop="4dp" />

    <TextView
        android:id="@+id/tvDescCourte"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Description courte..."
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:maxLines="2"
        android:ellipsize="end"
        android:layout_marginTop="2dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginTop="6dp">

        <TextView
            android:id="@+id/tvPrixProduit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0.0 DT"
            android:textColor="@color/primary_color"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_lilas"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="Détails"
            android:textColor="@color/primary_dark"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>