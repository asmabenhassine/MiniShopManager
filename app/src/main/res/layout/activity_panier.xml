<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <Button
            android:id="@+id/btnRetourPanier"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:backgroundTint="@color/lilas_pastel"
            android:text="← Retour"
            android:textColor="@color/primary_dark"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginEnd="10dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mon Panier"
            android:textColor="@color/primary_dark"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ListView
        android:id="@+id/listViewPanier"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/tvTotalPanier"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Total : 0.0 DT"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold"
        android:paddingVertical="12dp" />

    <Button
        android:id="@+id/btnPayer"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:backgroundTint="@color/primary_color"
        android:text="Passer au paiement"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnViderPanier"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:backgroundTint="#E11D48"
        android:text="Vider le panier"
        android:textColor="@color/white" />
</LinearLayout>